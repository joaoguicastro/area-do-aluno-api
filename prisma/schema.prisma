// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  ADMIN
  OPERADOR
  PROFESSOR
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Modality {
  ONLINE
  PRESENCIAL
}

model Curso {
  id           String   @id @default(cuid())
  nome         String
  modality     Modality
  duracaoHoras Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  videoAulas VideoAula[]

  Turma Turma[]

  Matricula Matricula[]

  Exercicio Exercicio[]

  Prova Prova[]

  VideoAulaProgresso VideoAulaProgresso[]

  Informativo Informativo[]

  Modulo Modulo[]
}

model Modulo {
  id String @id @default(cuid())
  cursoId String
  nome String
  ordem Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  VideoAula VideoAula[]
}

model VideoAula {
  id         String   @id @default(cuid())
  cursoId    String
  titulo     String
  descricao  String?
  urlVideo   String
  ordem      Int?
  duracaoMin Int?
  liberarEm  DateTime?
  createdAt  DateTime @default(now())
  moduloId String?

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  modulo Modulo? @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  VideoAulaProgresso VideoAulaProgresso[]
}

model Turma {
  id         String   @id @default(cuid())
  cursoId    String
  nome       String?
  capacidade Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  curso       Curso          @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  horarios    TurmaHorario[]
  Matricula   Matricula[]
  Informativo Informativo[]

  @@index([cursoId])
}

model TurmaHorario {
  id        String @id @default(cuid())
  turmaId   String
  diaSemana Int
  inicio    String
  fim       String

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
}

enum MatriculaStatus {
  ATIVA
  TRANCADA
  CANCELADA
  CONCLUIDA
}

model Aluno {
  id                  String   @id @default(cuid())
  nome                String
  cpfAluno            String   @unique
  matricula           String   @unique
  dataNascimentoAluno DateTime

  nomeResponsavel           String
  cpfResponsavel            String
  dataNascimentoResponsavel DateTime

  rua    String
  numero String
  bairro String
  cidade String

  telefone String?
  email    String?
  fotoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matriculas Matricula[]

  EntregaExercicio EntregaExercicio[]

  ProvaSubmissao ProvaSubmissao[]

  acesso AlunoAcesso?

  VideoAulaProgresso VideoAulaProgresso[]
}

model AlunoAcesso {
  id          String    @id @default(cuid())
  senhaHash   String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  alunoId     String    @unique
  aluno       Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
}

model Matricula {
  id         String          @id @default(cuid())
  alunoId    String
  cursoId    String
  turmaId    String?
  status     MatriculaStatus @default(ATIVA)
  dataInicio DateTime        @default(now())
  dataFim    DateTime?

  aluno Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  curso Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([cursoId])
  @@index([turmaId])
}

model Exercicio {
  id          String    @id @default(cuid())
  cursoId     String
  titulo      String
  descricao   String?
  dataEntrega DateTime?
  publicado   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  curso    Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  entregas EntregaExercicio[]

  @@index([cursoId])
}

model EntregaExercicio {
  id          String   @id @default(cuid())
  exercicioId String
  alunoId     String
  texto       String?
  arquivoUrl  String?
  enviadoEm   DateTime @default(now())
  nota        Float?

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  aluno     Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([exercicioId, alunoId])
  @@index([alunoId])
}

enum QuestaoTipo {
  MULTIPLA_ESCOLHA
  DISSERTATIVA
}

enum ProvaStatusSubmissao {
  EM_ANDAMENTO
  ENVIADA
  CORRIGIDA
}

model Prova {
  id         String    @id @default(cuid())
  cursoId    String
  titulo     String
  descricao  String?
  inicioEm   DateTime?
  fimEm      DateTime?
  duracaoMin Int?
  publicado  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  curso       Curso            @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  questoes    ProvaQuestao[]
  submissões ProvaSubmissao[]

  @@index([cursoId])
}

model ProvaQuestao {
  id        String      @id @default(cuid())
  provaId   String
  ordem     Int?
  tipo      QuestaoTipo
  enunciado String
  valor     Float?

  prova     Prova               @relation(fields: [provaId], references: [id], onDelete: Cascade)
  opcoes    ProvaQuestaoOpcao[]
  respostas ProvaResposta[]

  @@index([provaId])
}

model ProvaQuestaoOpcao {
  id        String  @id @default(cuid())
  questaoId String
  texto     String
  correta   Boolean @default(false)
  ordem     Int?

  questao       ProvaQuestao    @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  ProvaResposta ProvaResposta[]

  @@index([questaoId])
}

model ProvaSubmissao {
  id           String               @id @default(cuid())
  provaId      String
  alunoId      String
  iniciadoEm   DateTime             @default(now())
  finalizadoEm DateTime?
  notaTotal    Float?
  status       ProvaStatusSubmissao @default(EM_ANDAMENTO)

  prova     Prova           @relation(fields: [provaId], references: [id], onDelete: Cascade)
  aluno     Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  respostas ProvaResposta[]

  @@unique([provaId, alunoId])
  @@index([alunoId])
}

model ProvaResposta {
  id          String   @id @default(cuid())
  submissaoId String
  questaoId   String
  opcaoId     String?
  respostaTxt String?
  correta     Boolean?
  nota        Float?

  submissao ProvaSubmissao     @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  questao   ProvaQuestao       @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  opcao     ProvaQuestaoOpcao? @relation(fields: [opcaoId], references: [id])

  @@unique([submissaoId, questaoId])
  @@index([questaoId])
  @@index([opcaoId])
}

model VideoAulaProgresso {
  id          String    @id @default(cuid())
  alunoId     String
  cursoId     String
  videoAulaId String
  positionSec Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  aluno     Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  curso     Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  videoAula VideoAula @relation(fields: [videoAulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, videoAulaId])
  @@index([alunoId, cursoId])
}

model Informativo {
  id        String  @id @default(cuid())
  titulo    String
  conteudo  String
  publicado Boolean @default(true)

  cursoId String?
  turmaId String?

  curso Curso? @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cursoId])
  @@index([turmaId])
  @@index([createdAt])
}
